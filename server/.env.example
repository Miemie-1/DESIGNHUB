# Copy this file to .env and fill in your MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/designhub?retryWrites=true&w=majority
JWT_SECRET=change-this-to-a-long-random-string
PORT=5050
# one or more allowed frontend origins, comma-separated
CLIENT_URL=http://localhost:3000
